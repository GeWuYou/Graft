FROM golang:1.26-alpine AS build
WORKDIR /src
COPY fixture-server.go .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags='-s -w' -o /out/fixture-server fixture-server.go

FROM alpine:3.21
COPY --from=build /out/fixture-server /usr/local/bin/fixture-server
RUN ln -s fixture-server /usr/local/bin/curl
ENTRYPOINT ["/usr/local/bin/fixture-server"]
