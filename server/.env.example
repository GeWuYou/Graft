GRAFT_APP_NAME=graft
GRAFT_APP_ENV=local
# 嵌入式配置契约版本；升级后请按 `graft config validate --format patch` 的建议更新。
GRAFT_CONFIG_SCHEMA_VERSION=1
GRAFT_HTTP_ADDR=:8080
GRAFT_DATABASE_DRIVER=postgres
GRAFT_DATABASE_URL=postgres://graft:graft@localhost:5432/graft?sslmode=disable
# PostgreSQL connection pool
GRAFT_DATABASE_MAX_OPEN_CONNS=25
GRAFT_DATABASE_MAX_IDLE_CONNS=10
GRAFT_DATABASE_CONN_MAX_LIFETIME=1h
GRAFT_DATABASE_CONN_MAX_IDLE_TIME=30m
GRAFT_REDIS_ADDR=localhost:6379
GRAFT_REDIS_PASSWORD=
GRAFT_REDIS_DB=0
# Redis connection pool
# 0 means use go-redis default behavior.
GRAFT_REDIS_POOL_SIZE=0
GRAFT_REDIS_MIN_IDLE_CONNS=0
GRAFT_REDIS_MAX_IDLE_CONNS=0
GRAFT_REDIS_MAX_ACTIVE_CONNS=0
GRAFT_REDIS_POOL_TIMEOUT=0
GRAFT_REDIS_CONN_MAX_IDLE_TIME=0
GRAFT_REDIS_CONN_MAX_LIFETIME=0
GRAFT_I18N_DEFAULT_LOCALE=zh-CN
GRAFT_I18N_FALLBACK_LOCALE=zh-CN
GRAFT_I18N_SUPPORTED_LOCALES=zh-CN,en-US
GRAFT_LOG_LEVEL=info
# 日志分类聚合开关：使用 category=bool，支持最长已注册类别前缀匹配；false 会屏蔽该类别全部级别。
# 已注册类别：application、docker.stats、docker.events、runtime.cache、runtime.metrics、runtime.stats、compose.runtime、scheduler.poll、database.ent。
# TRACE 类别默认关闭，只有 GRAFT_LOG_LEVEL=trace 且类别显式为 true 时才输出；配置仅在服务启动时生效。
# GRAFT_LOG_CATEGORIES=docker=true,docker.stats=false
# Enables bounded managed-create diagnostics; workspace file contents are excluded.
GRAFT_PROJECT_MANAGED_CREATE_DEBUG=false
# 日志格式：auto|console|json。auto 下 local/dev/test 使用 console，prod/staging/未知环境使用 json。
GRAFT_LOG_FORMAT=auto
# 日志级别颜色：auto|always|never。仅 console 格式生效；auto 下本地类环境启用颜色，生产类环境无颜色。
GRAFT_LOG_COLOR=auto
# Gin 运行模式：auto|debug|release|test。auto 下 local/dev=debug，test=test，prod/staging/未知环境=release。
GRAFT_GIN_MODE=auto
# Access Log 控制台输出：auto|always|never|error_only。auto 下 local/dev=error_only，prod/staging/test/未知环境=never；持久化不受影响。
GRAFT_ACCESS_LOG_CONSOLE=auto
# 访问日志写入数据库的最大等待时间，单位毫秒；超时不会改变原始 HTTP 响应，也不会自动重试。
GRAFT_ACCESS_LOG_PERSIST_TIMEOUT_MS=1000
# 慢请求阈值，单位毫秒；当 Access Log 控制台策略为 error_only 时，4xx/5xx 或超过该阈值的请求会输出到控制台。
GRAFT_ACCESS_LOG_SLOW_THRESHOLD_MS=1000
# 当启用容器 Shell 时，必须显式列出允许发起 WebSocket 握手的前端 Origin，多个值使用英文逗号分隔。
# 该值必须填写浏览器实际访问前端页面的 Origin（协议 + 主机 + 端口），而不是后端 API 地址。
GRAFT_HTTPX_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
# 本地开发也必须至少配置 GRAFT_AUTH_JWT_SECRET 或 GRAFT_AUTH_SIGNING_KEY 之一；该示例值仅用于本地开发演示，生产环境必须替换。
GRAFT_AUTH_JWT_SECRET=local-demo-jwt-signing-key-2026-please-change

# Runtime policies such as log retention and container access are managed through System Config after startup.
# Keep this file limited to deployment and core startup configuration.
