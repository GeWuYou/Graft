FROM golang:1.27.4-alpine AS build
WORKDIR /src
COPY release-source.go .
RUN CGO_ENABLED=0 go build -trimpath -o /out/graft-release-fixture release-source.go

FROM alpine:3.24.4
COPY --from=build /out/graft-release-fixture /usr/local/bin/graft-release-fixture
ENTRYPOINT ["/usr/local/bin/graft-release-fixture"]
