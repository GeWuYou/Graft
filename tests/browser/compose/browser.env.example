# Browser acceptance environment inputs. scripts/browser_acceptance.py injects
# every value below automatically; this file documents them and allows manual
# `docker compose -f tests/browser/compose/docker-compose.browser.yml` runs.
# All values are local development identifiers, not credentials of any real system.
GRAFT_BROWSER_PG_HOST_PORT=55432
GRAFT_BROWSER_REDIS_HOST_PORT=56379
GRAFT_BROWSER_ADMIN_USERNAME=graft
GRAFT_BROWSER_ADMIN_PASSWORD=graft-admin
GRAFT_BROWSER_ACCEPTANCE_PASSWORD=graft-browser-acceptance-01
GRAFT_BROWSER_WEB_BASE_URL=http://127.0.0.1:4173
