# 本地开发默认通过 Vite dev proxy 把同源 `/api` HTTP 请求、`/healthz` 探针和 `/ws` WebSocket 请求转发到后端目标地址。
VITE_API_TARGET=http://127.0.0.1:3000
VITE_API_URL_PREFIX=/api
VITE_BASE_URL=/
VITE_IS_REQUEST_PROXY=true

# Frontend logger level. Keep the development console quiet by default; set to debug only during diagnosis.
VITE_LOG_LEVEL=warn

# Debug flags default to false in the Debug Runtime registry and may be enabled locally when diagnosing development issues.
# Debug flags stay off by default. Enable the relevant VITE_DEBUG_<MODULE>_<SUBMODULE> flag only during diagnosis.
VITE_DEBUG_CONTAINER_RAW_JSON=false
VITE_DEBUG_MANAGEMENT_TABLE_LAYOUT=false
VITE_DEBUG_PROJECT_TEMPLATES=false
VITE_DEBUG_PROJECT_WORKSPACE=false
