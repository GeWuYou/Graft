# 本地开发默认通过 Vite dev proxy 把同源 `/api` HTTP 请求和 `/ws` WebSocket 请求转发到后端目标地址。
VITE_BASE_URL=/
VITE_IS_REQUEST_PROXY=true
VITE_API_TARGET=http://127.0.0.1:3000
VITE_API_URL_PREFIX=/api

# Frontend debug toggles: set to true to enable extra debug logging, false to keep it off.
VITE_TABS_DEBUG=false
# Monaco debug runtime already reads this key; enable it locally when you want extra Monaco diagnostics.
VITE_PROJECT_MONACO_DEBUG=false
