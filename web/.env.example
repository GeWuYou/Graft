# 本地开发默认通过 Vite dev proxy 把同源 `/api` HTTP 请求和 `/ws` WebSocket 请求转发到后端目标地址。
VITE_API_TARGET=http://127.0.0.1:3000
VITE_API_URL_PREFIX=/api
VITE_BASE_URL=/
VITE_IS_REQUEST_PROXY=true

# Frontend debug toggles. `tabs` owns shell tab flow logs in `src/layouts/index.vue` and `src/store/modules/tabs-router.ts`.
VITE_DEBUG_TABS=false
# `tabs.layout` narrows logs to shell route-to-tab sync in `src/layouts/index.vue`.
VITE_DEBUG_TABS_LAYOUT=false
# `tabs.store` narrows logs to tab store recovery/mutation flow in `src/store/modules/tabs-router.ts`.
VITE_DEBUG_TABS_STORE=false
# `project.logs` owns project log snapshot, realtime subscription, batcher, and viewer diagnostics.
VITE_DEBUG_PROJECT_LOGS=false
# `project.monaco` owns Monaco runtime logs in `src/modules/project/shared/project-monaco*.ts` and Monaco surface components.
VITE_DEBUG_PROJECT_MONACO=false
