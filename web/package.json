{
  "name": "graft-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "dev:mock": "vite --mode mock",
    "dev:open": "vite --open --mode development",
    "build": "bun run typecheck && vite build --mode release",
    "build:release": "vite build --mode release",
    "build:test": "vite build --mode test",
    "build:type": "bun run typecheck",
    "lint": "eslint --ext .vue,.js,.jsx,.ts,.tsx ./ --max-warnings 0 && bun run log:governance:check",
    "lint:i18n": "STRICT_I18N_KEY_FIRST=true bun run scripts/check-i18n-governance.ts",
    "log:governance:check": "bun run scripts/check-log-governance.ts",
    "lint:fix": "eslint --ext .vue,.js,.jsx,.ts,.tsx ./ --max-warnings 0 --fix",
    "stylelint": "stylelint \"src/**/*.{html,vue,css,sass,less}\"",
    "stylelint:fix": "stylelint --fix \"src/**/*.{html,vue,css,sass,less}\"",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "typecheck:ts7:node": "bun x --no-install --bun --package typescript7 tsc --noEmit -p tsconfig.node.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "deadcode:check": "knip --config knip.config.ts --include files,exports,dependencies",
    "deadcode:fix": "knip --config knip.config.ts --include exports,dependencies --fix",
    "dupcode:check": "jscpd --config .jscpd.json",
    "font-size:check": "bun run scripts/check-font-size-governance.ts",
    "density:check": "bun run scripts/check-density-governance.ts",
    "scrollbar:check": "bun run scripts/check-scrollbar-governance.ts",
    "native-dialog:check": "bun run scripts/check-native-dialog-governance.ts",
    "native-button-theme:check": "bun run scripts/check-native-button-theme-governance.ts",
    "pagination:governance:check": "bun run scripts/check-pagination-governance.ts",
    "responsive:governance:check": "bun run scripts/check-responsive-governance.ts",
    "hygiene:check": "bun run deadcode:check && bun run dupcode:check && bun run font-size:check && bun run density:check && bun run scrollbar:check && bun run native-dialog:check && bun run native-button-theme:check && bun run responsive:governance:check",
    "contract:check:changed": "sh ../scripts/run_python.sh ../scripts/magic_value/check_magic_values.py --mode changed",
    "openapi:types": "mkdir -p src/contracts/openapi/generated && bun x openapi-typescript ../openapi/openapi.yaml -o src/contracts/openapi/generated/schema.ts && bun x prettier --write src/contracts/openapi/generated/schema.ts",
    "openapi:types:check": "sh -c 'tmp=openapi-types-check.ts; trap \"rm -f \\\"$tmp\\\"\" EXIT; bun x openapi-typescript ../openapi/openapi.yaml -o \"$tmp\" >/dev/null && bun x prettier --config .prettierrc.json --ignore-path .prettierignore --no-error-on-unmatched-pattern --write \"$tmp\" >/dev/null && cmp -s \"$tmp\" src/contracts/openapi/generated/schema.ts'",
    "openapi:frontend-governance:check": "bun run scripts/check-openapi-frontend-governance.ts",
    "check": "bun run check:source && bun run --parallel --no-exit-on-error check:tests build:release",
    "check:source": "bun run --parallel --no-exit-on-error format:check typecheck typecheck:ts7:node openapi:frontend-governance:check lint:i18n lint stylelint hygiene:check pagination:governance:check",
    "check:tests": "bun run test:run",
    "check:build": "node -e \"if (!require('node:fs').existsSync('dist/index.html')) process.exit(1)\""
  },
  "dependencies": {
    "@iconify-icons/lucide": "^2.0.31",
    "@iconify-icons/tabler": "^2.0.8",
    "@iconify/vue": "^5.0.5",
    "@tanstack/vue-query": "^5.107.1",
    "@vueuse/core": "^15.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.21.1",
    "consola": "^3.4.2",
    "cron-parser": "5.10.6",
    "cronstrue": "3.39.0",
    "dompurify": "^3.4.18",
    "echarts": "6.1.0",
    "lodash": "^4.18.1",
    "markdown-it": "^15.0.3",
    "monaco-editor": "^0.57.0",
    "monaco-yaml": "5.5.1",
    "nprogress": "^0.2.0",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "shiki": "^4.6.0",
    "tdesign-icons-vue-next": "^0.4.12",
    "tdesign-vue-next": "^1.20.11",
    "tinykeys": "^4.0.1",
    "tvision-color": "^1.6.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.20",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@d2t/vitest-ctrf-json-reporter": "1.3.0",
    "@eslint/js": "^10.0.1",
    "@tdesign-vue-next/auto-import-resolver": "^0.1.8",
    "@types/lodash": "^4.17.27",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^26.6.6",
    "@types/nprogress": "^0.2.3",
    "@unocss/vite": "^66.13.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jscpd": "4.3.0",
    "jsdom": "^31.0.1",
    "knip": "6.45.1",
    "less": "^4.9.1",
    "lint-staged": "^17.6.0",
    "mockjs": "^1.1.0",
    "openapi-typescript": "7.13.0",
    "postcss-html": "^2.0.0",
    "postcss-less": "^7.1.1",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-order": "^8.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "typescript7": "npm:typescript@7.0.2",
    "unocss": "^66.13.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.8",
    "vite-plugin-mock": "^3.0.2",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "3.3.14",
    "@redocly/openapi-core": "1.34.17"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue}": [
      "prettier --write",
      "eslint --fix --max-warnings 0 --no-warn-ignored"
    ],
    "*.{html,vue,css,sass,less}": [
      "stylelint --fix"
    ],
    "*.{css,less,md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
