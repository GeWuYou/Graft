{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "agent: prepare Docker Runtime development",
            "type": "shell",
            "command": "go run ./cmd/graft dev docker-runtime-agent prepare --database-mode isolated",
            "options": {
                "cwd": "${workspaceFolder}/server"
            },
            "problemMatcher": []
        },
        {
            "label": "agent: deliver Docker Runtime development",
            "type": "shell",
            "command": "go run ./cmd/graft dev docker-runtime-agent deliver --database-mode isolated",
            "options": {
                "cwd": "${workspaceFolder}/server"
            },
            "dependsOn": "agent: prepare Docker Runtime development",
            "problemMatcher": []
        },
        {
            "label": "agent: deliver prepared Docker Runtime development",
            "type": "shell",
            "command": "go run ./cmd/graft dev docker-runtime-agent deliver --prepared --database-mode isolated",
            "options": {
                "cwd": "${workspaceFolder}/server"
            },
            "problemMatcher": []
        },
        {
            "label": "web: dev",
            "type": "shell",
            "command": "export BUN_INSTALL=\"${BUN_INSTALL:-$HOME/.bun}\"; export PATH=\"$BUN_INSTALL/bin:$PATH\"; bun run dev",
            "options": {
                "cwd": "${workspaceFolder}/web"
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false
            },
            "problemMatcher": {
                "owner": "custom",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(?!x)x(.*)$",
                    "file": 1,
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*vite --mode development.*",
                    "endsPattern": ".*ready in .* ms.*"
                }
            }
        }
    ]
}
