###############################################################################
# Graft Docker Compose 配置 / Graft Docker Compose Configuration
#
# 首次部署 / First deployment:
#   1. 将本文件复制为 .env / Copy this file to .env
#   2. 修改 PostgreSQL 密码 / Change the PostgreSQL password
#   3. 修改 JWT Secret / Change the JWT secret
#   4. docker compose up -d
###############################################################################

###############################################################################
# 镜像 / Images
###############################################################################

# 选择官方镜像版本：latest、beta 或固定发行版本（例如 v1.2.3）。
# Select the official image version: latest, beta, or a fixed release version (for example v1.2.3).
# latest 跟随稳定频道，beta 跟随 Beta 频道；固定发行版本会锁定在该频道。受控 Update 解析并校验明确的发行版本及 digest，但跟随频道的配置值保持不变。
# latest tracks the stable channel and beta tracks the Beta channel; a fixed release tag pins that channel. Controlled Update resolves and validates an explicit release and digest while retaining a tracking tag.
GRAFT_IMAGE_TAG=latest

###############################################################################
# 应用 / Application
###############################################################################

GRAFT_APP_NAME=graft
GRAFT_APP_ENV=production
# 配置治理契约版本 / Configuration governance schema version
GRAFT_CONFIG_SCHEMA_VERSION=1

###############################################################################
# 平台自更新 / Platform self-update
###############################################################################

# 声明当前部署运行时为官方 Compose。Deployment Runtime 解析部署事实；Update、Backup 和 Restore 只消费其不可变上下文。
# Declare the official Compose deployment runtime. Deployment Runtime resolves deployment facts; Update, Backup, and Restore consume only its immutable context.
GRAFT_DEPLOYMENT_RUNTIME=compose

# 可选：Docker daemon 所在宿主机上的绝对 Compose 根目录。
# 不设置时，Deployment Runtime 会通过 Docker API 发现候选并要求管理员确认；不会自动保存选择结果。
# Optional absolute Compose root on the Docker daemon host.
# Leave unset to discover candidates through Docker API and require administrator confirmation.
# GRAFT_DEPLOYMENT_COMPOSE_ROOT=/absolute/path/to/graft

# graft-compose-runner 使用的命名卷，保存权威活动自更新状态。
# Server 以只读方式挂载，仅将已验证终态投影到 PostgreSQL 历史。
GRAFT_UPDATE_STATE_VOLUME=graft-update-state

# 恢复 runner 必须显式使用官方 graft-compose-runner 的不可变 SHA-256 引用。
# 该镜像独立于故障操作的 runner 镜像；未配置时恢复 API 会安全拒绝请求。
# GRAFT_UPDATE_RECOVERY_RUNNER_IMAGE=ghcr.io/gewuyou/graft-compose-runner@sha256:<64-hex-digest>

###############################################################################
# PostgreSQL
###############################################################################

POSTGRES_DB=graft
POSTGRES_USER=graft
# 密码（请务必修改）/ Password (must change this value)
POSTGRES_PASSWORD=change-me # trufflehog:ignore

# 数据库驱动 / Database driver
GRAFT_DATABASE_DRIVER=postgres

# 使用 Compose 自带 PostgreSQL。连接外部数据库时取消注释并填写完整 DSN。
# Use the bundled PostgreSQL service. Uncomment and set a complete DSN for an external database.
# GRAFT_DATABASE_URL=host=postgres port=5432 dbname=graft user=graft password=change-me sslmode=disable

# PostgreSQL 连接池 / PostgreSQL connection pool
# GRAFT_DATABASE_MAX_OPEN_CONNS=25
# GRAFT_DATABASE_MAX_IDLE_CONNS=10
# GRAFT_DATABASE_CONN_MAX_LIFETIME=1h
# GRAFT_DATABASE_CONN_MAX_IDLE_TIME=30m

###############################################################################
# JWT / Authentication
###############################################################################

# 签名密钥（请务必修改）/ Signing secret (必须 change this value)
GRAFT_AUTH_JWT_SECRET=change-me # trufflehog:ignore
# GRAFT_AUTH_SIGNING_KEY=change-me # trufflehog:ignore

###############################################################################
# Server
###############################################################################

GRAFT_HTTP_ADDR=:8080
GRAFT_SERVER_EXPOSE_PORT=8080

###############################################################################
# Docker 运行时 Agent / Docker Runtime Agent
###############################################################################

# 根 Compose 默认包含并启动 Agent；首次部署前必须完成 Runtime Target delivery、Vault PKI 和双 TLS listener 配置。
# Agent 不开放入站端口，未完成交付时 readiness 会保持失败。
GRAFT_HTTPX_AGENT_BOOTSTRAP_TLS_ENABLED=false
GRAFT_HTTPX_AGENT_BOOTSTRAP_TLS_ADDR=:8443
GRAFT_HTTPX_AGENT_BOOTSTRAP_TLS_PORT=8443
GRAFT_HTTPX_AGENT_BOOTSTRAP_TLS_CERTIFICATE_FILE=/run/graft/agent-server-tls/server-cert.pem
GRAFT_HTTPX_AGENT_BOOTSTRAP_TLS_KEY_FILE=/run/graft/agent-server-tls/server-key.pem
GRAFT_HTTPX_AGENT_TLS_ENABLED=false
GRAFT_HTTPX_AGENT_TLS_ADDR=:8444
GRAFT_HTTPX_AGENT_TLS_PORT=8444
GRAFT_HTTPX_AGENT_TLS_CERTIFICATE_FILE=/run/graft/agent-server-tls/server-cert.pem
GRAFT_HTTPX_AGENT_TLS_KEY_FILE=/run/graft/agent-server-tls/server-key.pem
GRAFT_HTTPX_AGENT_TLS_CLIENT_CA_FILE=/run/graft/agent-server-tls/agent-ca.pem
GRAFT_AGENT_SERVER_TLS_HOST_PATH=./.data/agent-server-tls

# Credential Vault 由外部部署提供。RoleID、SecretID、CA 和 enrollment pepper 必须留在该只读目录，不能写入 .env。
GRAFT_CREDENTIAL_VAULT_ENABLED=false
GRAFT_CREDENTIAL_VAULT_BACKEND=vault-pki
# GRAFT_CREDENTIAL_VAULT_ADDRESS=https://vault.example.internal:8200
GRAFT_CREDENTIAL_VAULT_CA_FILE=/run/graft/credential-vault/vault-ca.pem
GRAFT_CREDENTIAL_VAULT_AUTH_MOUNT=approle
# GRAFT_CREDENTIAL_VAULT_AUTH_ROLE=graft-docker-runtime-agent
GRAFT_CREDENTIAL_VAULT_AUTH_ROLE_ID_FILE=/run/graft/credential-vault/role_id
GRAFT_CREDENTIAL_VAULT_AUTH_SECRET_ID_FILE=/run/graft/credential-vault/secret_id
GRAFT_CREDENTIAL_VAULT_PKI_MOUNT=pki
# GRAFT_CREDENTIAL_VAULT_PKI_ROLE=graft-docker-runtime-agent
GRAFT_CREDENTIAL_VAULT_TRUST_BUNDLE_REF=vault://pki/cert/ca
GRAFT_ENROLLMENT_PEPPER_FILE=/run/graft/credential-vault/enrollment-pepper
GRAFT_CREDENTIAL_VAULT_HOST_PATH=./.data/credential-vault

# Agent 镜像自动跟随 GRAFT_IMAGE_TAG；delivery 写入的 config、token 和 trust bundle 必须以 UID 10001 可读权限交付。
GRAFT_DOCKER_RUNTIME_AGENT_CONFIG_HOST_PATH=./.data/docker-runtime-agent/config
GRAFT_DOCKER_RUNTIME_AGENT_BOOTSTRAP_HOST_PATH=./.data/docker-runtime-agent/bootstrap
GRAFT_DOCKER_RUNTIME_AGENT_TRUST_HOST_PATH=./.data/docker-runtime-agent/trust
GRAFT_DOCKER_RUNTIME_AGENT_STATE_HOST_PATH=./.data/docker-runtime-agent/state
# Docker daemon 的 socket GID，例如：stat -c '%g' /var/run/docker.sock
GRAFT_DOCKER_RUNTIME_AGENT_DOCKER_SOCKET_GID=65534

###############################################################################
# Web
###############################################################################

# Web 对外端口 / Web host port
GRAFT_WEB_HOST_PORT=3000

# Web 容器访问 Server / Server upstream used by the Web container
GRAFT_SERVER_UPSTREAM=http://server:8080

###############################################################################
# Redis
###############################################################################

# 默认使用 Compose 自带 Redis / Use the bundled Redis service by default
GRAFT_REDIS_ADDR=redis:6379
GRAFT_REDIS_PASSWORD=change-me # trufflehog:ignore
GRAFT_REDIS_DB=0

# Redis 连接池 / Redis connection pool
# GRAFT_REDIS_POOL_SIZE=0
# GRAFT_REDIS_MIN_IDLE_CONNS=0
# GRAFT_REDIS_MAX_IDLE_CONNS=0
# GRAFT_REDIS_MAX_ACTIVE_CONNS=0
# GRAFT_REDIS_POOL_TIMEOUT=0
# GRAFT_REDIS_CONN_MAX_IDLE_TIME=0
# GRAFT_REDIS_CONN_MAX_LIFETIME=0

###############################################################################
# 文档 / Documentation
###############################################################################

# 生产环境默认关闭 / Disabled by default in production
# GRAFT_DOCS_ENABLED=false

###############################################################################
# 日志 / Logging
###############################################################################

GRAFT_LOG_LEVEL=info
GRAFT_LOG_FORMAT=auto
GRAFT_LOG_COLOR=auto
GRAFT_GIN_MODE=auto
GRAFT_ACCESS_LOG_CONSOLE=auto
GRAFT_ACCESS_LOG_SLOW_THRESHOLD_MS=1000
GRAFT_LOG_APP_LOG_PERSIST=true

# Product MCP Streamable HTTP. It is disabled by default and uses the existing auth/audit runtime path.
# GRAFT_MCP_ENABLED=false
# GRAFT_MCP_CONFIRMATION_TOKEN_TTL=5m

# Optional module allow list. Empty means all compiled modules stay enabled.
# GRAFT_MODULES_ENABLED=

# 高频日志分类 / High-frequency log categories
GRAFT_LOG_CATEGORIES=docker=true,docker.stats=false

###############################################################################
# 调试 / Diagnostics
###############################################################################

# 仅用于本地诊断或一次性开发数据库 / For local diagnostics or disposable development databases only
# GRAFT_PROJECT_LOG_DEBUG=false
# GRAFT_PROJECT_MANAGED_CREATE_DEBUG=false
# GRAFT_RUNTIME_DEV_ALLOW_DIRTY_MIGRATION_BOOTSTRAP=false

###############################################################################
# 国际化 / Internationalization
###############################################################################

GRAFT_I18N_DEFAULT_LOCALE=zh-CN
GRAFT_I18N_FALLBACK_LOCALE=zh-CN
GRAFT_I18N_SUPPORTED_LOCALES=zh-CN,en-US

###############################################################################
# Token / Session
###############################################################################

GRAFT_AUTH_ACCESS_TOKEN_TTL=15m
GRAFT_AUTH_REFRESH_TOKEN_TTL=168h
GRAFT_AUTH_REFRESH_COOKIE_NAME=graft_refresh_token
GRAFT_AUTH_REFRESH_COOKIE_SECURE=false
GRAFT_AUTH_REFRESH_COOKIE_SAME_SITE=lax
GRAFT_AUTH_REFRESH_COOKIE_PATH=/

###############################################################################
# 模块 / Modules
###############################################################################

# 留空表示启用所有已编译模块 / Empty means all compiled modules are enabled
GRAFT_MODULES_ENABLED=

###############################################################################
# 导入目录 / Import directories
###############################################################################

GRAFT_PROJECT_IMPORT_HOST_PATH=./.data/imports
GRAFT_PROJECT_IMPORT_CONTAINER_PATH=/srv/graft-imports
GRAFT_PROJECT_IMPORT_DEFAULT_PATH=/srv/graft-imports

###############################################################################
# Application Root
###############################################################################

# 宿主机目录会以读写方式挂载到 Server 容器 / Mounted read-write into the Server container
GRAFT_APPLICATION_ROOT_HOST_PATH=./.data/apps

###############################################################################
# Backup Artifact Root
###############################################################################

# 该宿主机目录以读写方式挂载到 Server，保存仅由 Backup 模块创建的配置快照和数据库导出。
# This host directory is mounted read-write into Server for Backup-owned config snapshots and database dumps.
GRAFT_BACKUP_ARTIFACT_HOST_PATH=./.data/backups
GRAFT_BACKUP_ARTIFACT_ROOT=/var/lib/graft/backups

###############################################################################
# Docker 运维 / Docker operations
###############################################################################

# Compose 默认挂载 Docker Socket / The root Compose file mounts the Docker Socket by default
GRAFT_OPS_CONTAINER_RUNTIME=first-adapter
GRAFT_OPS_CONTAINER_DOCKER_ENDPOINT=unix:///var/run/docker.sock

###############################################################################
# Registry credential source
###############################################################################

# 可选：只读 JSON Secret 文件的容器内绝对路径。Registry 凭据只由核心 CredentialProvider
# 在一次性 Runtime Target Docker 配置中注入；不得把用户名、密码或 token 写入此 .env 文件。
# Optional absolute in-container path to a read-only JSON secret file. Registry credentials
# are injected only into one-operation Runtime Target Docker configs; never put a username,
# password, or token in this .env file.
# GRAFT_REGISTRY_CREDENTIALS_FILE=/run/secrets/graft_registry_credentials.json

# 容器访问、Shell、危险操作、日志尾数和采样策略由 System Config 管理。
# Container access, Shell, dangerous actions, log limits, and sampling are managed by System Config.

###############################################################################
# WebSocket
###############################################################################

# 本地访问默认允许 3000 端口 / Local access defaults to port 3000
GRAFT_HTTPX_WEBSOCKET_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# 通过 HTTPS、域名、局域网 IP 或反向代理访问时，请替换为浏览器实际 Origin。
# When using HTTPS, a hostname, a LAN IP, or a reverse proxy, replace this with the browser-visible Origin.

###############################################################################
# 前端开发配置 / Frontend development configuration
###############################################################################

# 根 Compose 不读取 VITE_*；请将其保留在 web/.env.*。
# Root Compose does not consume VITE_*; keep those settings in web/.env.*.
