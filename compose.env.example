# Release images published by this repository's tag workflow. Use `beta` only for disposable test environments;
# use an immutable vMAJOR.MINOR.PATCH-beta.N tag to reproduce or roll back a Beta deployment.
GRAFT_SERVER_IMAGE=ghcr.io/gewuyou/graft-server
GRAFT_WEB_IMAGE=ghcr.io/gewuyou/graft-web
GRAFT_IMAGE_TAG=latest

# Application identity. Default: graft.
# GRAFT_APP_NAME=graft

# Application environment. Default: production. Controls docs exposure and runtime mode.
# GRAFT_APP_ENV=production

# PostgreSQL bootstrap database credentials used by the bundled postgres service.
POSTGRES_DB=graft
POSTGRES_USER=graft
POSTGRES_PASSWORD=change-me # trufflehog:ignore

# Required runtime signing secret for the server auth module. Configure at least one of
# GRAFT_AUTH_JWT_SECRET or GRAFT_AUTH_SIGNING_KEY, and replace any demo value in real deployments.
GRAFT_AUTH_JWT_SECRET=change-me # trufflehog:ignore
# GRAFT_AUTH_SIGNING_KEY=change-me # trufflehog:ignore

# Optional runtime overrides. Leave commented to use the server or web image defaults.

# Server listen address inside the container. Default: :8080.
# GRAFT_HTTP_ADDR=:8080

# Server port exposed to other compose services. Keep aligned with GRAFT_HTTP_ADDR.
# GRAFT_SERVER_EXPOSE_PORT=8080

# Optional explicit PostgreSQL DSN. Leave commented to use the bundled postgres service above.
# Keep shared templates free of hard-coded password-like placeholders; append the password field locally when needed.
# GRAFT_DATABASE_URL=host=postgres port=5432 dbname=graft user=graft sslmode=disable

# Optional explicit Redis address. Leave commented to use the bundled redis service below.
# GRAFT_REDIS_ADDR=redis:6379

# OpenAPI docs exposure. Default in production: false.
# GRAFT_DOCS_ENABLED=false

# Server log level. Default: info. Supported: trace, debug, info, warn, error, dpanic, panic, fatal.
# GRAFT_LOG_LEVEL=info

# Aggregate high-frequency category rules. Use category=bool entries separated by commas; a false rule suppresses every
# level, while TRACE stays disabled unless its category or a registered namespace prefix is explicitly true. Registered
# categories: application, docker.stats, docker.events, runtime.cache, runtime.metrics, runtime.stats, compose.runtime,
# scheduler.poll, database.ent. The setting is read when the server starts.
# GRAFT_LOG_CATEGORIES=docker=true,docker.stats=false

# Server log encoder. Default: auto.
# GRAFT_LOG_FORMAT=auto

# Server log color policy for console logs. Default: auto.
# GRAFT_LOG_COLOR=auto

# Gin runtime mode. Default: auto.
# GRAFT_GIN_MODE=auto

# Access log console emission policy. Default: auto.
# GRAFT_ACCESS_LOG_CONSOLE=auto

# Slow request threshold in milliseconds for access log console output. Default: 1000.
# GRAFT_ACCESS_LOG_SLOW_THRESHOLD_MS=1000

# Whether application logs persist to PostgreSQL. Default: true.
# GRAFT_LOG_APP_LOG_PERSIST=true

# PostgreSQL connection pool. Defaults: 25 / 10 / 1h / 30m.
# GRAFT_DATABASE_MAX_OPEN_CONNS=25
# GRAFT_DATABASE_MAX_IDLE_CONNS=10
# GRAFT_DATABASE_CONN_MAX_LIFETIME=1h
# GRAFT_DATABASE_CONN_MAX_IDLE_TIME=30m

# Redis auth and DB selection. Defaults: empty password and DB 0.
# GRAFT_REDIS_PASSWORD=
# GRAFT_REDIS_DB=0

# Redis connection pool. Default 0 values defer to go-redis behavior.
# GRAFT_REDIS_POOL_SIZE=0
# GRAFT_REDIS_MIN_IDLE_CONNS=0
# GRAFT_REDIS_MAX_IDLE_CONNS=0
# GRAFT_REDIS_MAX_ACTIVE_CONNS=0
# GRAFT_REDIS_POOL_TIMEOUT=0
# GRAFT_REDIS_CONN_MAX_IDLE_TIME=0
# GRAFT_REDIS_CONN_MAX_LIFETIME=0

# i18n defaults. Defaults: zh-CN fallback with zh-CN,en-US support.
# GRAFT_I18N_DEFAULT_LOCALE=zh-CN
# GRAFT_I18N_FALLBACK_LOCALE=zh-CN
# GRAFT_I18N_SUPPORTED_LOCALES=zh-CN,en-US

# Token and refresh-session behavior. Defaults: 15m access token, 168h refresh token.
# GRAFT_AUTH_ACCESS_TOKEN_TTL=15m
# GRAFT_AUTH_REFRESH_TOKEN_TTL=168h

# Refresh cookie settings. Defaults: graft_refresh_token / false / lax / /.
# GRAFT_AUTH_REFRESH_COOKIE_NAME=graft_refresh_token
# GRAFT_AUTH_REFRESH_COOKIE_SECURE=false
# GRAFT_AUTH_REFRESH_COOKIE_SAME_SITE=lax
# GRAFT_AUTH_REFRESH_COOKIE_PATH=/

# Optional module allow list. Empty means all compiled modules stay enabled.
# GRAFT_MODULES_ENABLED=

# Web runtime upstream used by the nginx container. Default: http://server:8080.
# GRAFT_SERVER_UPSTREAM=http://server:8080

# Host port published by the web nginx container. Default: 80.
# GRAFT_WEB_HOST_PORT=80

# Default import directory mount for the server container.
# The host path is mounted read-only into the server container so the import folder picker can browse real files.
# Adjust these when your Compose projects live somewhere else on the host.
# GRAFT_PROJECT_IMPORT_HOST_PATH=./.data/imports
# GRAFT_PROJECT_IMPORT_CONTAINER_PATH=/srv/graft-imports
# GRAFT_PROJECT_IMPORT_DEFAULT_PATH=/srv/graft-imports

# Managed application root. The host directory is mounted read-write at the same path inside the server container.
# The bundled application-root-init service creates it and assigns ownership to the server user (10001:10001).
# The Docker daemon must be able to create, chown, and chmod this host path; CI should use a writable runner temp path.
# Prepare it yourself before deployment when host policy requires it:
#   install -d -m 0750 -o 10001 -g 10001 /opt/graft/apps
# GRAFT_APPLICATION_ROOT_HOST_PATH=/opt/graft/apps

# Container deployment configuration. Mount docker.sock with compose.ops-container.yml before selecting a local Docker provider.
# The compose ops-container overlay auto-detects the mounted docker.sock group id at container startup, so no extra
# GID environment variable is required for the standard Docker Compose deployment path.
# GRAFT_OPS_CONTAINER_RUNTIME=first-adapter
# GRAFT_OPS_CONTAINER_DOCKER_ENDPOINT=unix:///var/run/docker.sock
# Container access, Shell, dangerous actions, log limits, and sampling policy are configured in System Config.

# Required only when you need to override the compose default for container shell WebSocket origins.
# By default, root compose derives an allowlist from GRAFT_WEB_HOST_PORT and permits:
#   - http://127.0.0.1:<GRAFT_WEB_HOST_PORT>
#   - http://localhost:<GRAFT_WEB_HOST_PORT>
# Set this explicitly when the browser reaches the web container through HTTPS, a non-local hostname, a LAN IP, or a reverse proxy.
# The allowlist is also used by the unified realtime `/ws` gateway, so container stats and other topic subscriptions will fail
# if the browser-visible origin is not listed here.
# GRAFT_HTTPX_WEBSOCKET_ALLOWED_ORIGINS=

# The root compose deployment entrypoint does not consume Vite development variables.
# Keep VITE_* settings in web/.env.* only; they are development-only and do not belong here.
